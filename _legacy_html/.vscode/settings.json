{
  "editor.formatOnSave": true,
  "editor.tabSize": 2,
  "editor.wordWrap": "on",
  "files.associations": {
    "*.css": "css",
    "*.html": "html",
    "*.js": "javascript"
  },
  "emmet.includeLanguages": {
    "javascript": "javascriptreact"
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.html": "${capture}.css, ${capture}.js",
    "index.html": "pages"
  },
  "liveServer.settings.root": "/",
  "html.customData": []
}
